/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Not(in = a, out = na);
    And(a = na, b = b, out = r0);
    Not(in = b, out = nb);
    And(a = a, b = nb, out = r1);
    Or(a = r0, b = r1, out = out);
}